DATABASE_URL="{DATABASE_URL}"

# Loops Email Service
# Get your API key from https://app.loops.so/settings?page=api
LOOPS_API_KEY="{LOOPS_API_KEY}"

# Transactional email IDs from Loops dashboard
# Create these emails in Loops and add their IDs here
LOOPS_MAGIC_LINK_ID="{TRANSACTIONAL_ID}"
LOOPS_OTP_SIGNIN_ID="{TRANSACTIONAL_ID}"
LOOPS_OTP_VERIFICATION_ID="{TRANSACTIONAL_ID}"
LOOPS_OTP_PASSWORD_RESET_ID="{TRANSACTIONAL_ID}"
LOOPS_EMAIL_VERIFICATION_ID="{TRANSACTIONAL_ID}"
LOOPS_PASSWORD_RESET_ID="{TRANSACTIONAL_ID}"