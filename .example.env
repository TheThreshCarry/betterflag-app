DATABASE_URL="{DATABASE_URL}"

# Supabase (Auth + Postgres + RLS)
# Project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="{SUPABASE_URL}"
# Anon (publishable) key — safe for the browser, RLS enforced
NEXT_PUBLIC_SUPABASE_ANON_KEY="{SUPABASE_ANON_KEY}"
# Service-role key — server-only, bypasses RLS (sync, webhooks, admin)
SUPABASE_SERVICE_ROLE_KEY="{SUPABASE_SERVICE_ROLE_KEY}"
# JWT secret — used to verify JWTs in the worker
SUPABASE_JWT_SECRET="{SUPABASE_JWT_SECRET}"
# Shared secret for Supabase "User created" webhook → /api/auth/hooks/user-created
SUPABASE_WEBHOOK_SECRET="{SUPABASE_WEBHOOK_SECRET}"

# Better Auth (deprecated — kept during Phase 1/2 cutover, removed once Supabase Auth is live)
BETTER_AUTH_SECRET="{RANDOM_SECRET_STRING}"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare worker (media, KV sync). Must match the worker deployment URL.
WORKER_API_URL="http://localhost:8787"
# Shared secret: set the same value in the worker (SERVICE_SECRET) and the Next.js app.
SERVICE_SECRET="{SERVICE_SECRET}"

# Sync webhook secret: used by /api/sync to authenticate internal sync requests.
SYNC_WEBHOOK_SECRET="{SYNC_WEBHOOK_SECRET}"

# Resend Email Service
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="{RESEND_API_KEY}"
# Verified sender address — verify your domain at https://resend.com/domains
RESEND_FROM="ShipOS <auth@yourdomain.com>"

# Polar Payment Integration (via @polar-sh/supabase adapter)
# Get your access token from Polar Organization Settings
POLAR_ACCESS_TOKEN="{POLAR_ACCESS_TOKEN}"
# Webhook secret from Polar webhook endpoint configuration
POLAR_WEBHOOK_SECRET="{POLAR_WEBHOOK_SECRET}"
# Post-checkout redirect URL
POLAR_SUCCESS_URL="http://localhost:3000/dashboard/settings/billing?success=true"
# sandbox | production
POLAR_SERVER="sandbox"
# Product IDs from Polar Dashboard
POLAR_PRO_PRODUCT_ID="{PRODUCT_ID_FROM_POLAR_DASHBOARD}"
POLAR_TEAM_PRODUCT_ID="{PRODUCT_ID_FROM_POLAR_DASHBOARD}"

# Tinybird Analytics (customer-facing analytics + flag evaluations)
# Host: https://api.tinybird.co (EU) or https://api.us-east.aws.tinybird.co (US) etc.
TINYBIRD_HOST="https://api.tinybird.co"
# Worker-only ingest token (write to events + flag_evaluations datasources)
TINYBIRD_INGEST_TOKEN="{TINYBIRD_INGEST_TOKEN}"
# Dashboard read token (or admin token used to sign per-request tokens)
TINYBIRD_ADMIN_TOKEN="{TINYBIRD_ADMIN_TOKEN}"

# PostHog — product analytics + feature flags
NEXT_PUBLIC_POSTHOG_KEY="{POSTHOG_PROJECT_API_KEY}"
NEXT_PUBLIC_POSTHOG_HOST="https://t.shipos.app"

# Better Stack — Logs (Pino transport, server-only)
BETTER_STACK_SOURCE_TOKEN="{YOUR_SOURCE_TOKEN}"
BETTER_STACK_LOGS_ENDPOINT="https://{YOUR_INGESTING_HOST}"

# Better Stack — Error tracking (Sentry-compatible DSN)
NEXT_PUBLIC_SENTRY_DSN="https://{APP_TOKEN}@{INGESTING_HOST}/1"

# Better Stack — Tracing (OTLP HTTP, read automatically by @vercel/otel)
OTEL_EXPORTER_OTLP_ENDPOINT="https://{YOUR_OTEL_ENDPOINT}"
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer {YOUR_SOURCE_TOKEN}"