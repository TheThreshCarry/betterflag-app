DATABASE_URL="{DATABASE_URL}"

# Better Auth
BETTER_AUTH_SECRET="{RANDOM_SECRET_STRING}"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare worker (media, KV sync). Must match the worker deployment URL.
WORKER_API_URL="http://localhost:8787"
# Shared secret: set the same value in the worker (SERVICE_SECRET) and the Next.js app.
SERVICE_SECRET="{SERVICE_SECRET}"

# Sync webhook secret: used by /api/sync to authenticate internal sync requests.
SYNC_WEBHOOK_SECRET="{SYNC_WEBHOOK_SECRET}"

# Loops Email Service
# Get your API key from https://app.loops.so/settings?page=api
LOOPS_API_KEY="{LOOPS_API_KEY}"

# Transactional email IDs from Loops dashboard
# Create these emails in Loops and add their IDs here
LOOPS_MAGIC_LINK_ID="{TRANSACTIONAL_ID}"
LOOPS_OTP_SIGNIN_ID="{TRANSACTIONAL_ID}"
LOOPS_OTP_VERIFICATION_ID="{TRANSACTIONAL_ID}"
LOOPS_OTP_PASSWORD_RESET_ID="{TRANSACTIONAL_ID}"
LOOPS_EMAIL_VERIFICATION_ID="{TRANSACTIONAL_ID}"
LOOPS_PASSWORD_RESET_ID="{TRANSACTIONAL_ID}"

# Polar Payment Integration
# Get your access token from Polar Organization Settings
POLAR_ACCESS_TOKEN="{POLAR_ACCESS_TOKEN}"
# Webhook secret from Polar webhook endpoint configuration
POLAR_WEBHOOK_SECRET="{POLAR_WEBHOOK_SECRET}"
# Product IDs from Polar Dashboard
POLAR_PRO_PRODUCT_ID="{PRODUCT_ID_FROM_POLAR_DASHBOARD}"
POLAR_TEAM_PRODUCT_ID="{PRODUCT_ID_FROM_POLAR_DASHBOARD}"

# ClickHouse Analytics (optional — required for flag analytics)
CLICKHOUSE_URL="{CLICKHOUSE_URL}"
CLICKHOUSE_USER="default"
CLICKHOUSE_PASSWORD="{CLICKHOUSE_PASSWORD}"
CLICKHOUSE_DATABASE="shipos_analytics"