<mjml>
  <mj-head>
    <mj-title>Verify your ShipOS account</mj-title>
    <mj-preview>Click here to verify your email and get started with ShipOS</mj-preview>
    <mj-attributes>
      <mj-all font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text line-height="1.6" color="#1a1a1a" font-size="15px" />
      <mj-button font-size="14px" font-weight="600" border-radius="8px" />
    </mj-attributes>
    <mj-style inline="inline">
      .bold { font-weight: 600; }
      .link-nostyle { color: #6b7280 !important; text-decoration: none !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9fafb" width="600px">
    <mj-section padding="40px 20px 20px 20px">
      <mj-column>
        <mj-image
          src="logo.png"
          width="120px"
          align="center"
          alt="ShipOS"
          border-radius="12%"
        ></mj-image>
      </mj-column>
    </mj-section>
    <mj-section padding="0 20px">
      <mj-column
        width="100%"
        padding="1px"
        background-color="#e5e7eb"
        inner-background-color="#ffffff"
        border-radius="12px"
        inner-border-radius="12px"
      >
        <mj-text padding="32px 32px 0 32px" font-size="22px" font-weight="700" color="#0f172a">
          Welcome to ShipOS! 🚀
        </mj-text>
        <mj-text padding="16px 32px 0 32px">
          Thanks for signing up! You're just one click away from shipping faster than ever before.<br /><br />
          Click the button below to verify your email address and activate your account.
        </mj-text>
        <mj-button
          align="left"
          background-color="#10b981"
          color="#ffffff"
          padding="24px 32px"
          inner-padding="14px 28px"
          href="{DATA_VARIABLE:verificationUrl}"
        >Verify my email →</mj-button>
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="8px 32px" />
        <mj-text padding="16px 32px" font-size="13px" color="#6b7280">
          Or copy and paste this link into your browser:<br />
          <span style="word-break: break-all; color: #3b82f6;">{DATA_VARIABLE:verificationUrl}</span>
        </mj-text>
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="8px 32px" />
        <mj-text padding="16px 32px" font-size="13px" color="#6b7280">
          <strong>What's next?</strong>
        </mj-text>
        <mj-text padding="0 32px 8px 32px" font-size="13px" color="#6b7280">
          ✓ Set up your first project<br />
          ✓ Invite your team members<br />
          ✓ Start shipping!
        </mj-text>
        <mj-text padding="8px 32px 32px 32px" font-size="13px" color="#6b7280">
          If you didn't create a ShipOS account, please ignore this email.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 20px 40px 20px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
          © 2025 ShipOS. All rights reserved.<br />
          <a href="https://shipos.app" class="link-nostyle">shipos.app</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

