<mjml>
  <mj-head>
    <mj-title>Verify your email address</mj-title>
    <mj-preview>Your verification code: {DATA_VARIABLE:otpCode}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'SF Pro Display', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" />
      <mj-text line-height="1.6" color="#1a1a1a" font-size="15px" />
    </mj-attributes>
    <mj-style inline="inline">
      .bold { font-weight: 600; }
      .link-nostyle { color: #6b7280 !important; text-decoration: none !important; }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9fafb" width="600px">
    <mj-section padding="40px 20px 20px 20px">
      <mj-column>
        <mj-image
          src="logo.png"
          width="120px"
          align="center"
          alt="ShipOS"
          border-radius="12%"
        ></mj-image>
      </mj-column>
    </mj-section>
    <mj-section padding="0 20px">
      <mj-column
        width="100%"
        padding="1px"
        background-color="#e5e7eb"
        inner-background-color="#ffffff"
        border-radius="12px"
        inner-border-radius="12px"
      >
        <mj-text padding="32px 32px 0 32px" font-size="22px" font-weight="700" color="#0f172a">
          Verify your email
        </mj-text>
        <mj-text padding="16px 32px 0 32px">
          Welcome to ShipOS! 🚀<br /><br />
          You're almost there. Enter this code to verify your email address and complete your signup.
        </mj-text>
        <mj-text padding="24px 32px" align="center">
          <span style="display: inline-block; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff; font-size: 32px; font-weight: 700; letter-spacing: 8px; padding: 16px 32px; border-radius: 12px; font-family: 'SF Mono', Monaco, 'Courier New', monospace;">
            {DATA_VARIABLE:otpCode}
          </span>
        </mj-text>
        <mj-text padding="0 32px 16px 32px" align="center" font-size="13px" color="#6b7280">
          This code expires in 10 minutes
        </mj-text>
        <mj-divider border-color="#e5e7eb" border-width="1px" padding="8px 32px" />
        <mj-text padding="16px 32px 32px 32px" font-size="13px" color="#6b7280">
          If you didn't create a ShipOS account, please ignore this email. No action is needed.
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section padding="24px 20px 40px 20px">
      <mj-column>
        <mj-text align="center" font-size="12px" color="#9ca3af">
          © 2025 ShipOS. All rights reserved.<br />
          <a href="https://shipos.app" class="link-nostyle">shipos.app</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>

