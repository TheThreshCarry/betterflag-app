{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betterflag-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Control-plane origin the tools proxy to. Override for local dev:
  //   wrangler dev --var BETTERFLAG_API_URL:http://localhost:3000
  // Native Worker logs/traces export through Cloudflare destination
  // `betterflag-otel` (Betterflag OTel source). Direct HTTP POST unused.
  "vars": {
    "BETTERFLAG_API_URL": "https://app.betterflag.app",
    "BETTERFLAG_DASHBOARD_URL": "https://app.betterflag.app",
    "BETTERFLAG_ENV": "production",
    "BETTER_STACK_LOGS_ENDPOINT": "https://s2692129.eu-central-1a.betterstackdata.com"
  },

  // OAuth token/grant/client storage for @cloudflare/workers-oauth-provider
  // (the binding name OAUTH_KV is required by the library). Create with:
  //   wrangler kv namespace create OAUTH_KV
  // then paste the returned id below.
  // The consent flow also needs a shared secret (same value in the
  // dashboard's MCP_OAUTH_SHARED_SECRET env):
  //   openssl rand -hex 32 | wrangler secret put MCP_OAUTH_SHARED_SECRET
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "a25f4548344a49948313f5c854a8f7fa"
    }
  ],

  // The agents SDK backs each MCP session with a Durable Object.
  "durable_objects": {
    "bindings": [
      {
        "name": "MCP_OBJECT",
        "class_name": "BetterFlagMcp"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BetterFlagMcp"]
    }
  ],

  "routes": [
    { "pattern": "mcp.betterflag.app", "custom_domain": true }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "destinations": ["betterflag-otel"],
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "destinations": ["betterflag-otel"],
      "head_sampling_rate": 1
    }
  },
  "tail_consumers": [{ "service": "betterflag-tail" }],

  // Distinct dev ports so parallel `wrangler dev` instances don't collide on
  // the inspector port (9229 is the shared default and does not auto-increment).
  "dev": {
    "port": 8789,
    "inspector_port": 9231
  }
}
