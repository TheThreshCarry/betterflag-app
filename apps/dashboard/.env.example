# ── apps/dashboard (control plane) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: dashboard server env ONLY. Never in workers or client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare, used by the control plane to publish KV snapshots (kill-switch
# fast path) and enqueue config-sync messages via the Queues HTTP API.
# All Cloudflare calls no-op with a console.warn when these are unset (dev).
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
CF_QUEUE_CONFIG_SYNC_ID=

# Cloudflare R2 (public media: org logos, project pictures).
# S3 API token needs Object Read & Write on the media bucket.
# Served from the custom domain (R2_PUBLIC_BASE_URL).
# Upload routes return 503 when these are unset.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://media.shipos.app

# ClickHouse (usage + stats reads from the dashboard; optional in dev -
# usage endpoints degrade to empty series when unset)
CLICKHOUSE_URL=https://YOUR-INSTANCE.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Analytics seed (`bun run analytics:seed`) — writes synthetic evaluations
# SEED_ORG_ID=
# SEED_PROJECT_ID=
# SEED_ENV=dev
# SEED_COUNT=1000
# SEED_COUNT_MIN=500
# SEED_COUNT_MAX=2000
# SEED_COUNTRIES=random   # or: all | US,FR,DE
# SEED_COUNTRY_COUNT=20
# SEED_PERIOD_HOURS=24

# Public URLs
NEXT_PUBLIC_EDGE_URL=https://edge.shipos.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MCP OAuth consent flow. The MCP worker runs the OAuth server; the dashboard
# hosts the consent screen (/mcp/consent) and talks to the worker's
# /internal/oauth/* endpoints with this shared secret (same value as the
# worker's MCP_OAUTH_SHARED_SECRET secret - generate with `openssl rand -hex 32`).
SHIPOS_MCP_URL=https://mcp.shipos.app
MCP_OAUTH_SHARED_SECRET=

# Lifecycle worker (welcome email sequence). Org creation POSTs to
# {LIFECYCLE_URL}/trigger with this bearer secret (same value as the worker's
# LIFECYCLE_SECRET secret - generate with `openssl rand -hex 32`). Both
# optional; org creation no-ops the trigger with a console.warn when unset.
LIFECYCLE_URL=https://lifecycle.shipos.app
LIFECYCLE_SECRET=cHeBDXiFJJ9vqZH

# PostHog (EU cloud) - public project token, proxied through /dock
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_YOUR_PROJECT_TOKEN
