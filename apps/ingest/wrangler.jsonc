{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betterflag-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "destinations": ["betterflag-otel"],
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "destinations": ["betterflag-otel"],
      "head_sampling_rate": 1
    }
  },
  "tail_consumers": [{ "service": "betterflag-tail" }],
  // Distinct dev ports so parallel `wrangler dev` instances don't collide on
  // the inspector port (9229 is the shared default and does not auto-increment).
  "dev": {
    "port": 8788,
    "inspector_port": 9230
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "1ddc8e69bb1b491e85da5fa9b9fcc7bc"
    }
  ],
  // Cold storage for raw analytics: `wrangler r2 bucket create betterflag-analytics-cold`.
  "r2_buckets": [
    {
      "binding": "ANALYTICS_R2",
      "bucket_name": "betterflag-analytics-cold"
    }
  ],
  // Daily analytics tiering at 03:10 UTC (hot ClickHouse day → R2, retention
  // sweep). Hourly Polar metering + SDK-key quota stamp at minute 0.
  // Cron strings must match POLAR_METER_CRON in src/meter.ts and the
  // cold-storage path in src/index.ts (`controller.cron` dispatch).
  "triggers": {
    "crons": ["10 3 * * *", "0 * * * *"]
  },
  "queues": {
    "consumers": [
      {
        "queue": "betterflag-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "betterflag-events-dlq"
      },
      {
        "queue": "betterflag-config-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 10
      },
      {
        "queue": "betterflag-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 0
      }
    ]
  },
  // Native Worker logs/traces export through Cloudflare destination
  // `betterflag-otel`. Heartbeat URL is a SECRET (Betterflag ClickHouse backup):
  //   echo <heartbeat url> | wrangler secret put BETTER_STACK_HEARTBEAT_URL
  "vars": {
    "SUPABASE_URL": "https://tnlbktwyrctrxmpoafwb.supabase.co",
    "BETTERFLAG_ENV": "production",
    "BETTER_STACK_LOGS_ENDPOINT": "https://s2692129.eu-central-1a.betterstackdata.com"
  }
}
