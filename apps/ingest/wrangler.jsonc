{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipos-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "1ddc8e69bb1b491e85da5fa9b9fcc7bc"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "shipos-events",
        "max_batch_size": 100,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "shipos-events-dlq"
      },
      {
        "queue": "shipos-config-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 10
      }
    ]
  },
  "vars": {
    "SUPABASE_URL": "https://tnlbktwyrctrxmpoafwb.supabase.co"
  }
  // Secrets (set via `wrangler secret put <NAME>`):
  //   SUPABASE_SERVICE_ROLE_KEY
  //   CLICKHOUSE_URL
  //   CLICKHOUSE_USER
  //   CLICKHOUSE_PASSWORD
}
