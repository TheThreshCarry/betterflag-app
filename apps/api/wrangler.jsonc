{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "betterflag-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "destinations": ["betterflag-otel"],
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "destinations": ["betterflag-otel"],
      "head_sampling_rate": 1
    }
  },
  "tail_consumers": [{ "service": "betterflag-tail" }],
  // Distinct dev ports so parallel `wrangler dev` instances don't collide on
  // the inspector port (9229 is the shared default and does not auto-increment).
  "dev": {
    "port": 8787,
    "inspector_port": 9229
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "1ddc8e69bb1b491e85da5fa9b9fcc7bc"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "betterflag-events"
      }
    ]
  },
  // Workers Analytics Engine dual-write (ITR-62 Phase 1, shadow mode).
  // ClickHouse via the EVENTS queue stays the source of truth until the
  // parity check over the dual-write window passes (Phase 2).
  "analytics_engine_datasets": [
    {
      "binding": "EVALS",
      "dataset": "betterflag_evaluations"
    }
  ],
  // Native Worker logs/traces export through Cloudflare destination
  // `betterflag-otel` (Betterflag OTel source). Direct HTTP POST is unused
  // at runtime: "worker". Token leftover is optional.
  "vars": {
    "BETTERFLAG_ENV": "production",
    "BETTER_STACK_LOGS_ENDPOINT": "https://s2692129.eu-central-1a.betterstackdata.com",
    // Kill switch for the ITR-62 AE dual-write (flip to "false" + redeploy).
    "ANALYTICS_AE_ENABLED": "true"
  },
  "routes": [{ "pattern": "api.betterflag.app", "custom_domain": true }]
}
