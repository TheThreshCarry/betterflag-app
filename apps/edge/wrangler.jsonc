{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipos-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "REPLACE_ME"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "shipos-events"
      }
    ]
  }
  // Production route — enable once DNS for edge.shipos.app is on this zone:
  // "routes": [{ "pattern": "edge.shipos.app", "custom_domain": true }]
}
