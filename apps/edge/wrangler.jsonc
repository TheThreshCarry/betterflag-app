{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipos-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // Distinct dev ports so parallel `wrangler dev` instances don't collide on
  // the inspector port (9229 is the shared default and does not auto-increment).
  "dev": {
    "port": 8787,
    "inspector_port": 9229
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "1ddc8e69bb1b491e85da5fa9b9fcc7bc"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "shipos-events"
      }
    ]
  },
  // Observability (Better Stack). Logs AND OTLP traces both go to the
  // "shipos-edge" source (same endpoint + token) for one-click log↔trace
  // correlation. The endpoint is non-secret; the ingest token is a SECRET:
  //   echo <shipos-edge source token> | wrangler secret put BETTER_STACK_SOURCE_TOKEN
  // For `wrangler dev` the token comes from apps/edge/.dev.vars (gitignored).
  "vars": {
    "SHIPOS_ENV": "production",
    "BETTER_STACK_LOGS_ENDPOINT": "https://s2578178.eu-fsn-3.betterstackdata.com"
  }
  // Production route — enable once DNS for edge.shipos.app is on this zone:
  // "routes": [{ "pattern": "edge.shipos.app", "custom_domain": true }]
}
