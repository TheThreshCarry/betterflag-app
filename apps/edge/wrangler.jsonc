{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shipos-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "observability": {
    "enabled": true
  },
  // Distinct dev ports so parallel `wrangler dev` instances don't collide on
  // the inspector port (9229 is the shared default and does not auto-increment).
  "dev": {
    "port": 8787,
    "inspector_port": 9229
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "1ddc8e69bb1b491e85da5fa9b9fcc7bc"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "shipos-events"
      }
    ]
  }
  // Production route — enable once DNS for edge.shipos.app is on this zone:
  // "routes": [{ "pattern": "edge.shipos.app", "custom_domain": true }]
}
