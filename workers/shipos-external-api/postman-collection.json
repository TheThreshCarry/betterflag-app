{
  "info": {
    "name": "ShipOS External API",
    "description": "Complete test collection for the ShipOS External API (Cloudflare Worker).\n\nAll /v1/* endpoints require the `x-shipos-key` header.\nOptional headers: `x-shipos-env`, `x-shipos-customer-id`, `x-shipos-sdk-version`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "YOUR_API_KEY_HERE",
      "type": "string"
    },
    {
      "key": "environment",
      "value": "production",
      "type": "string"
    },
    {
      "key": "customerId",
      "value": "customer-123",
      "type": "string"
    },
    {
      "key": "sdkVersion",
      "value": "0.1.0",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "YOUR_ORG_ID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "GET /health — No authentication required. Returns service status."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Controllers",
      "item": [
        {
          "name": "List Controllers (Discovery)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/controllers",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "controllers"]
            },
            "description": "GET /v1/controllers — Returns metadata about all registered v1 controllers."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Feature Flags",
      "item": [
        {
          "name": "Get All Flags",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" },
              { "key": "x-shipos-customer-id", "value": "{{customerId}}" },
              { "key": "x-shipos-sdk-version", "value": "{{sdkVersion}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/flags",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flags"]
            },
            "description": "GET /v1/flags — Returns all feature flags for the authenticated organization and environment. Also triggers an analytics insert into ClickHouse (non-blocking)."
          },
          "response": []
        },
        {
          "name": "Get Flags (staging env)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "staging" },
              { "key": "x-shipos-customer-id", "value": "{{customerId}}" },
              { "key": "x-shipos-sdk-version", "value": "{{sdkVersion}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/flags",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flags"]
            },
            "description": "GET /v1/flags — Same endpoint, but with x-shipos-env set to 'staging'."
          },
          "response": []
        },
        {
          "name": "Get Flags (no auth — should 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/flags",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flags"]
            },
            "description": "GET /v1/flags — Without API key, should return 401 Unauthorized."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Global Config",
      "item": [
        {
          "name": "Get Config by Slug",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/config/app-settings",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "config", "app-settings"]
            },
            "description": "GET /v1/config/:slug — Returns the config data for the given slug. Replace 'app-settings' with your actual config slug."
          },
          "response": []
        },
        {
          "name": "Get Config (missing slug — should 400)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/config/",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "config", ""]
            },
            "description": "GET /v1/config/ — No slug provided, should 404 or fall through."
          },
          "response": []
        },
        {
          "name": "Get Config (invalid slug — should 400)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/config/invalid slug!",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "config", "invalid slug!"]
            },
            "description": "GET /v1/config/:slug — Invalid slug with special characters, should return 400."
          },
          "response": []
        },
        {
          "name": "Get Config (nonexistent — should 404)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/config/does-not-exist",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "config", "does-not-exist"]
            },
            "description": "GET /v1/config/:slug — Slug that doesn't exist in KV, should return 404."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Customers",
      "item": [
        {
          "name": "Identify Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"user-42\",\n  \"metadata\": {\n    \"name\": \"Jane Doe\",\n    \"plan\": \"pro\",\n    \"signedUpAt\": \"2025-06-15T10:00:00Z\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers/identify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "customers", "identify"]
            },
            "description": "POST /v1/customers/identify — Creates or updates a customer record in KV by external ID."
          },
          "response": []
        },
        {
          "name": "Identify Customer (minimal — no metadata)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"externalId\": \"user-99\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers/identify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "customers", "identify"]
            },
            "description": "POST /v1/customers/identify — Minimal payload with just externalId."
          },
          "response": []
        },
        {
          "name": "Identify Customer (missing externalId — should 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metadata\": { \"foo\": \"bar\" }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers/identify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "customers", "identify"]
            },
            "description": "POST /v1/customers/identify — Missing externalId, should return 400."
          },
          "response": []
        },
        {
          "name": "Identify Customer (invalid body — should 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "not valid json"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/customers/identify",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "customers", "identify"]
            },
            "description": "POST /v1/customers/identify — Invalid JSON body, should return 400."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Media",
      "item": [
        {
          "name": "Upload Media Asset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Select a file to upload"
                },
                {
                  "key": "organizationId",
                  "value": "{{orgId}}",
                  "type": "text"
                },
                {
                  "key": "userId",
                  "value": "user-1",
                  "type": "text"
                },
                {
                  "key": "folder",
                  "value": "/",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/media/upload",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "media", "upload"]
            },
            "description": "POST /v1/media/upload — Upload a file to R2. Expects multipart/form-data."
          },
          "response": []
        },
        {
          "name": "Serve Media Asset",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/media/serve/{{orgId}}/example-uuid.png",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "media", "serve", "{{orgId}}", "example-uuid.png"]
            },
            "description": "GET /v1/media/serve/:orgId/* — Serve a media asset by its R2 key path. Replace 'example-uuid.png' with an actual file key."
          },
          "response": []
        },
        {
          "name": "Delete Media Asset",
          "request": {
            "method": "POST",
            "header": [
              { "key": "x-shipos-key", "value": "{{apiKey}}" },
              { "key": "x-shipos-env", "value": "{{environment}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key\": \"media/YOUR_ORG_ID/example-uuid.png\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/media/delete",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "media", "delete"]
            },
            "description": "POST /v1/media/delete — Delete a media asset from R2 by its key."
          },
          "response": []
        }
      ]
    },
