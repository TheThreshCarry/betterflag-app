    {
      "name": "Auth Edge Cases",
      "item": [
        {
          "name": "Missing API Key (should 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/v1/flags",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flags"]
            },
            "description": "No x-shipos-key header — should return 401 MISSING_API_KEY."
          },
          "response": []
        },
        {
          "name": "Invalid API Key (should 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "invalid-key-that-does-not-exist" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/flags",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flags"]
            },
            "description": "Invalid API key — should return 401 API_KEY_NOT_FOUND."
          },
          "response": []
        },
        {
          "name": "Short API Key (should 401)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "x-shipos-key", "value": "short" }
            ],
            "url": {
              "raw": "{{baseUrl}}/v1/flags",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "flags"]
            },
            "description": "API key shorter than 8 characters — should return 401 INVALID_API_KEY."
          },
          "response": []
        }
      ]
