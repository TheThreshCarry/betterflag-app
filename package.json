{
  "name": "shipos-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "ba-generate": "bun x @better-auth/cli@latest generate --config=lib/auth/index.ts -y && mv ./auth-schema.ts lib/auth/auth-schema.ts",
    "better-auth-studio": "pnpm better-auth-studio start --config=lib/auth/index.ts",
    "drizzle-studio": "bunx drizzle-kit studio",
    "drizzle-migrate": "bunx drizzle-kit migrate",
    "drizzle-generate": "bunx drizzle-kit generate",
    "drizzle-push": "bunx drizzle-kit push",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:docker:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:docker:down": "docker compose -f docker-compose.test.yml down -v",
    "test:db:migrate": "DATABASE_URL=postgresql://test:test@localhost:5433/shipos_test bunx drizzle-kit migrate",
    "test:db:setup": "bun run test:docker:up && bun run test:db:migrate",
    "test:k6:smoke": "k6 run k6/scenarios/smoke.js",
    "test:k6:load": "k6 run k6/scenarios/load.js",
    "test:k6:stress": "k6 run k6/scenarios/stress.js",
    "test:k6:spike": "k6 run k6/scenarios/spike.js",
    "test:all": "bash scripts/test-all.sh"
  },
  "dependencies": {
    "@clickhouse/client": "^1.17.0",
    "@daveyplate/better-auth-ui": "^3.3.9",
    "@polar-sh/better-auth": "^1.8.0",
    "@polar-sh/sdk": "^0.42.5",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/core": "^3.19.0",
    "@tiptap/extension-bubble-menu": "^3.19.0",
    "@tiptap/extension-drag-handle-react": "3.19.0",
    "@tiptap/extension-emoji": "^3.19.0",
    "@tiptap/extension-image": "^3.19.0",
    "@tiptap/extension-link": "^3.19.0",
    "@tiptap/extension-placeholder": "^3.19.0",
    "@tiptap/extension-task-item": "^3.19.0",
    "@tiptap/extension-task-list": "^3.19.0",
    "@tiptap/extension-typography": "^3.21.0",
    "@tiptap/extension-underline": "^3.19.0",
    "@tiptap/pm": "^3.19.0",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "better-auth": "^1.4.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "framer-motion": "^12.34.0",
    "ioredis": "^5.10.1",
    "loops": "^6.0.1",
    "lucide-react": "^0.563.0",
    "maplibre-gl": "^5.18.0",
    "next": "16.1.0",
    "next-themes": "^0.4.6",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "2.15.4",
    "semver": "^7.7.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.0",
    "jsdom": "^29.0.1",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
