DESCRIPTION >
    One row per feature-flag evaluation served by the edge worker.
    Source of truth for flag analytics dashboards.

SCHEMA >
    `organization_id` String `json:$.organization_id`,
    `environment` LowCardinality(String) `json:$.environment`,
    `customer_id` String `json:$.customer_id`,
    `flag_key` String `json:$.flag_key`,
    `flag_value` UInt8 `json:$.flag_value`,
    `timestamp` DateTime64(3) `json:$.timestamp`,
    `country` LowCardinality(String) `json:$.country`,
    `city` String `json:$.city`,
    `region` String `json:$.region`,
    `continent` LowCardinality(String) `json:$.continent`,
    `latitude` Float64 `json:$.latitude`,
    `longitude` Float64 `json:$.longitude`,
    `timezone` LowCardinality(String) `json:$.timezone`,
    `user_agent` String `json:$.user_agent`,
    `sdk_version` LowCardinality(String) `json:$.sdk_version`,
    `request_id` String `json:$.request_id`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(timestamp)"
ENGINE_SORTING_KEY "organization_id, timestamp, flag_key"
ENGINE_TTL "timestamp + INTERVAL 180 DAY"
