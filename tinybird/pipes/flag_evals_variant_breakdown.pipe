DESCRIPTION >
    Variant breakdown per flag (enabled vs disabled ratios).

TOKEN "flag_evals_read" READ

NODE variants
SQL >
    %
    SELECT
        flag_key,
        countIf(flag_value = 1) AS enabled,
        countIf(flag_value = 0) AS disabled,
        round(100 * countIf(flag_value = 1) / count(), 2) AS enabled_pct
    FROM flag_evaluations
    WHERE organization_id = {{ String(organization_id, required=True) }}
      {% if defined(environment) %}AND environment = {{ String(environment) }}{% end %}
      AND timestamp BETWEEN {{ DateTime(from) }} AND {{ DateTime(to) }}
    GROUP BY flag_key
    ORDER BY enabled + disabled DESC
