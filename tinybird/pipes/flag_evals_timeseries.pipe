DESCRIPTION >
    Flag evaluations over time for a given org + optional flag_key.
    Used by the dashboard flag analytics page.

TOKEN "flag_evals_read" READ

NODE evals
SQL >
    %
    SELECT
        toStartOfInterval(timestamp, INTERVAL {{ Int32(bucket_minutes, 60) }} MINUTE) AS ts,
        flag_key,
        countIf(flag_value = 1) AS enabled_count,
        countIf(flag_value = 0) AS disabled_count,
        count() AS total
    FROM flag_evaluations
    WHERE organization_id = {{ String(organization_id, required=True) }}
      {% if defined(environment) %}AND environment = {{ String(environment) }}{% end %}
      {% if defined(flag_key) %}AND flag_key = {{ String(flag_key) }}{% end %}
      AND timestamp BETWEEN {{ DateTime(from) }} AND {{ DateTime(to) }}
    GROUP BY ts, flag_key
    ORDER BY ts ASC
