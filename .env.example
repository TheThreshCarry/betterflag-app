# ── apps/dashboard (control plane) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: dashboard server env ONLY. Never in workers or client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare, used by the control plane to publish KV snapshots (kill-switch
# fast path) and enqueue config-sync messages via the Queues HTTP API.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
CF_QUEUE_CONFIG_SYNC_ID=

# ClickHouse (usage + stats reads from the dashboard; optional in dev -
# usage endpoints degrade to empty series when unset)
CLICKHOUSE_URL=https://YOUR-INSTANCE.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Public URLs
NEXT_PUBLIC_API_URL=https://api.betterflag.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── apps/api (set via `wrangler secret put` / wrangler.jsonc bindings) ─────
# KV binding:      CONFIG_KV      (namespace: betterflag-config)
# Queue producer:  EVENTS         (queue: betterflag-events)

# ── apps/ingest (set via `wrangler secret put`) ─────────────────────────────
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY  (config-sync snapshot rebuilds)
# CLICKHOUSE_URL, CLICKHOUSE_USER, CLICKHOUSE_PASSWORD
# KV binding:      CONFIG_KV      (same namespace as api)
# Queue consumers: betterflag-events, betterflag-config-sync (+ betterflag-events-dlq)

# ── apps/mcp (set via `wrangler secret put`) ────────────────────────────────
# BETTERFLAG_API_URL=https://app.betterflag.app   (control plane base URL)

# ── Observability (Better Stack), all services via @betterflag/observability ────
# See docs/OBSERVABILITY.md. Missing values degrade to console-only logging and
# no-op tracing, so local dev works without any of these set.
#
# Dashboard / admin / landing (Node) POST OTLP logs+traces to Betterflag OTel.
# Workers export through Cloudflare destination `betterflag-otel` (same source).
# Tail Worker POSTs sanitized summaries to Betterflag Tail.
BETTER_STACK_SOURCE_TOKEN=            # Betterflag OTel source ingest token
BETTER_STACK_LOGS_ENDPOINT=https://s2692129.eu-central-1a.betterstackdata.com
BETTER_STACK_ERRORS_DSN=              # Better Stack Errors Sentry-compatible DSN
NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN=
BETTERFLAG_ENV=development                # deployment.environment attribute (prod/staging/dev)
# BETTERFLAG_GIT_SHA=                      # deploy-time commit; appended to the app's VERSION → release "0.1.2+a1b9f3c" (see docs/versioning.md)
# BETTERFLAG_RELEASE=                      # optional: full release string; overrides VERSION + git SHA verbatim
#
# Optional trace-routing override, set ONLY to send OTLP traces to a different
# source than logs (this gives up correlation):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://s2692129.eu-central-1a.betterstackdata.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_SOURCE_TOKEN
#
# Workers: Cloudflare Observability destination name must be `betterflag-otel`.
# Tail Worker secret: BETTER_STACK_SOURCE_TOKEN for the Betterflag Tail source.
# Ingest secret: BETTER_STACK_HEARTBEAT_URL for the ClickHouse backup heartbeat.

# Polar billing (dashboard). Must be explicit — unset used to silently hit Polar sandbox.
# Create an Organization Access Token at:
#   https://polar.sh/dashboard/betterflag/settings → Developers → New Token
POLAR_SERVER=production
POLAR_ACCESS_TOKEN=
