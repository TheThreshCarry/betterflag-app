# ── apps/dashboard (control plane) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: dashboard server env ONLY. Never in workers or client.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare, used by the control plane to publish KV snapshots (kill-switch
# fast path) and enqueue config-sync messages via the Queues HTTP API.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_KV_NAMESPACE_ID=
CF_QUEUE_CONFIG_SYNC_ID=

# ClickHouse (usage + stats reads from the dashboard; optional in dev -
# usage endpoints degrade to empty series when unset)
CLICKHOUSE_URL=https://YOUR-INSTANCE.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Public URLs
NEXT_PUBLIC_EDGE_URL=https://edge.shipos.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── apps/edge (set via `wrangler secret put` / wrangler.jsonc bindings) ─────
# KV binding:      CONFIG_KV      (namespace: shipos-config)
# Queue producer:  EVENTS         (queue: shipos-events)

# ── apps/ingest (set via `wrangler secret put`) ─────────────────────────────
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY  (config-sync snapshot rebuilds)
# CLICKHOUSE_URL, CLICKHOUSE_USER, CLICKHOUSE_PASSWORD
# KV binding:      CONFIG_KV      (same namespace as edge)
# Queue consumers: shipos-events, shipos-config-sync (+ shipos-events-dlq)

# ── apps/mcp (set via `wrangler secret put`) ────────────────────────────────
# SHIPOS_API_URL=https://app.shipos.app   (control plane base URL)

# ── Observability (Better Stack), all services via @shipos/observability ────
# See docs/OBSERVABILITY.md. Missing values degrade to console-only logging and
# no-op tracing, so local dev works without any of these set.
#
# Dashboard (Node) reads these from this .env / Vercel project env. Logs AND
# OTLP traces both go to the "shipos-dashboard" source → one-click log↔trace
# correlation in Better Stack (no OTEL_* needed):
BETTER_STACK_SOURCE_TOKEN=            # "shipos-dashboard" source ingest token (logs + traces)
BETTER_STACK_LOGS_ENDPOINT=https://sXXXXXXX.eu-fsn-3.betterstackdata.com
SHIPOS_ENV=development                # deployment.environment attribute (prod/staging/dev)
# SHIPOS_GIT_SHA=                      # deploy-time commit; appended to the app's VERSION → release "0.1.2+a1b9f3c" (see docs/versioning.md)
# SHIPOS_RELEASE=                      # optional: full release string; overrides VERSION + git SHA verbatim
#
# Optional trace-routing override, set ONLY to send OTLP traces to a different
# source than logs (this gives up correlation):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://sXXXXXXX.eu-fsn-3.betterstackdata.com
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_SOURCE_TOKEN
#
# Workers (edge / ingest / mcp) each have their OWN source. Endpoints are
# committed in apps/*/wrangler.jsonc `vars`; the ingest token is a secret -
# see apps/*/.dev.vars.example and `wrangler secret put`.
